# 빌드 산출물 — 소스에서 재생성된다
dist/

# 로컬 프리뷰 — 매 실행마다 10개 HTML이 생성된다
_preview/

# 하네스 중간 산출물 — 사후 추적용이지만 저장소에는 넣지 않는다
_workspace/
_workspace_*/

node_modules/
__pycache__/

# 린트/렌더러를 파이썬으로 직접 import해 시험할 때 생긴다
__pycache__/
*.pyc

# 라이브 스킨 백업 — 개인 블로그 자산이므로 저장소에 넣지 않는다
backup/

.DS_Store
*.log

# Claude Code worktree — 전략에서는 뺐지만, 생기면 소스가 아니다
.claude/worktrees/
