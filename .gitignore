# 빌드 산출물 — 소스에서 재생성된다
dist/

# 로컬 프리뷰 — 매 실행마다 12개 HTML이 생성된다
_preview/

# 빌드·프리뷰 동시 실행 잠금과 빌드 임시 폴더(이슈 #100) — 실행 중에만 있다
/.dist.lock
/.dist.lock.*
/.dist.tmp-*
/.preview.lock
/.preview.lock.*

# 하네스 중간 산출물 — 사후 추적용이지만 저장소에는 넣지 않는다
_workspace/
_workspace_*/

node_modules/
__pycache__/

# 린트/렌더러를 파이썬으로 직접 import해 시험할 때 생긴다
__pycache__/
*.pyc

# 라이브 스킨 백업 — 개인 블로그 자산이므로 저장소에 넣지 않는다
backup/

# 블로그 글 초안 — 저장소가 공개이고 초안에는 회사 코드 이야기가 들어갈 수 있다. 블로그에 올린 글(posts/<카테고리>/…)은 커밋한다
/posts/_drafts
/posts/**/_drafts/

.DS_Store
*.log

# Claude Code worktree — 전략에서는 뺐지만, 생기면 소스가 아니다
.claude/worktrees/

# PR 리뷰 게이트 마커 — 리뷰가 통과한 커밋 SHA. 로컬 상태이지 소스가 아니다
.claude/.pr-review-ok
